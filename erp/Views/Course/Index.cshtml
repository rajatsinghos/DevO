@model IEnumerable<ERP.Models.Course>

@{
    ViewData["Title"] = "Index";
}

<h1>Courses</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CourseName)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Duration)
            </th>

            <th>
                Department
            </th>

            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CourseName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Duration)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Department.DepartmentName)
                </td>

                <td>
                    <a asp-action="Edit" asp-route-courseid="@item.CourseId">Edit</a> |
                    <a asp-action="Details" asp-route-courseid="@item.CourseId">Details</a> |
                    <a asp-action="Delete" asp-route-courseid="@item.CourseId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>